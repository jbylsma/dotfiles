# SSH settings cannot be overridden; first wins.
#
# Match OriginalHost {host} exec "whereami home"
#   Port {internal port}
# Host {host}
#   HostName {host url}
#   Port {external port}

# Tagged profiles, selected with `ssh -P {tag}` or `-o Tag={tag}`. These come
# first so they override host and default settings.
#
# Don't record the host or reuse shared sessions. Useful for throwaway hosts.
Match tagged ephemeral
  UserKnownHostsFile /dev/null
  StrictHostKeyChecking no
  ControlPath none
  LogLevel ERROR

# Force password entry. Useful for testing a reset password.
Match tagged password
  PreferredAuthentications keyboard-interactive,password
  ControlPath none

Include hosts/*.conf

Host *
  # Any keys added through SSH should use confirm, which prompts the user to
  # confirm key usage.
  AddKeysToAgent confirm

  # Send a message every X seconds to maintain an open connection
  ServerAliveInterval 60

  # Start shared sessions automatically.
  ControlMaster auto

  # Set path for control sockets for shared sessions.
  ControlPath ~/.ssh/sessions/control-%C

  # Keep shared session connections of X seconds after SSH session is closed.
  # Useful when creating many connections like SCPing multiple files.
  ControlPersist 5

# vi:ft=sshconfig
