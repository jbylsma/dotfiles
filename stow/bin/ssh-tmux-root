#!/usr/bin/env bash
# Quickly SSH to a server with tmux-root
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") {ssh args...} {ssh_server}"
  echo "Requires tmux-root to be in the server's bin path."
}

# Disable terminal focus-event reporting on this pane in case a dropped
# connection left the remote tmux-root unable to disable it itself. Skip it
# when output isn't a terminal so redirected output stays clean.
cleanup() {
  if [[ -t 1 ]]; then
    printf '\e[?1004l'
  fi
}

main() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  host="${*: -1}"
  set -- "${@:1:$(($#-1))}"

  trap cleanup EXIT
  ssh -t "$@" "${host}" 'bash -lc tmux-root'
}
main "$@"
