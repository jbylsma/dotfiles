#!/usr/bin/env bash
# sure: switch user, retain environment
#
# Runs a command (default: a login shell) as root with this user's HOME and
# PATH. PATH is passed through env because sudo's secure_path replaces it.
#
# When the command exits, root-owned files in this user's cache, config and
# state directories are returned to the user in the background; nohup keeps
# the cleanup alive when sudo closes its pty. If the session dies instead
# (e.g. a dropped connection), the next normal exit catches up.
set -euo pipefail

for env in HOME SHELL; do
  if [[ -z "${!env:-}" ]]; then
    echo "${env} not set" >&2
    exit 1
  fi
done

if (( $# == 0 )); then
  set -- "${SHELL}" -l
fi

exec sudo -E env HOME="${HOME}" PATH="${PATH}" bash -c '
  "$@"
  rc=$?
  nohup find "${HOME}/.cache" "${HOME}/.config" "${HOME}/.local" \
    -xdev -user 0 -exec chown -h "${SUDO_UID}:${SUDO_GID}" {} + \
    </dev/null >/dev/null 2>&1 &
  exit "${rc}"
' sure "$@"
