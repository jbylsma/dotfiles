{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-notify 'Task completed' complete"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-notify 'Needs input' input"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-notify --clear"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-notify --clear"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "attribution": {
    "commitTrailers": false
  },
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "vim",
  "agentPushNotifEnabled": true
}
