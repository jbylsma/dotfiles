#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

VALUE_COLOR=${color:-$(xrescat i3xrocks.value.color "#D8DEE9")}
LABEL_COLOR=${label_color:-$(xrescat i3xrocks.label.color "#7B8394")}
VALUE_FONT=${font:-$(xrescat i3xrocks.value.font "Source Code Pro Medium 13")}

# Get a timer's remaining time.
#
# Returns:
#   The remaining time, formatted as MM:SS.
get_timer_remaining() {
  local timer="$1"
  local response
  local dbus_response
  local total_seconds

  # A failed query falls through to the invalid response error
  # shellcheck disable=SC2310 # _dbus runs only dbus-send
  response="$(_dbus GetTimerRemaining "string:${timer}" || true)"
  read -ra dbus_response <<< "${response}"
  if [[ ${#dbus_response[@]} -eq 2 && ${dbus_response[0]} = 'int32' ]]; then
    total_seconds="${dbus_response[1]}"
    printf '%i:%.2i\n' $(( total_seconds / 60 )) $(( total_seconds % 60 ))
  else
    echo "Invalid timer response for ${timer}: ${dbus_response[*]}" >&2
    exit 1
  fi
}

# Query dbus for values.
#
# Returns:
#   The unformatted dbus response.
_dbus() {
  local method="$1"
  shift

  dbus-send \
    --print-reply=literal \
    --dest=org.workrave.Workrave \
    /org/workrave/Workrave/Core \
    "org.workrave.CoreInterface.${method}" \
    "$@" 2>/dev/null
}

# span for text
fspan() {
  echo "<span font_desc=\"${VALUE_FONT}\" color=\"${VALUE_COLOR}\"> ${1}</span>"
}

# span for label/icon
lspan() {
  echo "<span font_desc=\"${VALUE_FONT}\" color=\"${LABEL_COLOR}\">${1}</span>"
}


# shellcheck disable=SC2034 # Not displayed yet
MICROBREAK="$(get_timer_remaining microbreak)"
RESTBREAK="$(get_timer_remaining restbreak)"

icon="$(lspan "")"
restbreak_value="$(fspan "${RESTBREAK}")"
echo "${icon} ${restbreak_value}"

if [[ "${button:-}" == 1 ]]; then
  /usr/bin/i3-msg -q exec \
    "dbus-send \
      --type=method_call \
      --dest=org.workrave.Workrave \
      /org/workrave/Workrave/UI \
      org.workrave.ControlInterface.RestBreak"
fi
