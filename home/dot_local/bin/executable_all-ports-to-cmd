#!/usr/bin/env bash
#
# Show all listening processes and their ports
#
set -eo pipefail
shopt -s inherit_errexit

######################
# Get all open ports
######################
get_open_ports() {
  sudo lsof -Pni | \
    awk '$NF ~ "(LISTEN)" { gsub("^.+:", "", $(NF - 1)); print $(NF - 1); }' | \
    sort -nu
}

########
# Main
########
main() {
  local ports
  local port

  ports="$(get_open_ports)"
  while read -r port; do
    printf "%s\\t" "${port}"
    port-to-cmd "${port}" 2>&1
  done <<< "${ports}"
}
main "$@"
