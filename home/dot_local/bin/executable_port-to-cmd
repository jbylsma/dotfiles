#!/usr/bin/env bash
#
# Show what process is listening on a port
#

set -e

###############
# Basic usage
###############
function usage () {
  echo "Usage: $(basename "$0") {port}" >&2
}

########
# Main
########
function main() {
  local port
  local listing
  local pid

  if [[ $# -ne 1 ]]; then
    usage
    exit 1
  fi

  # Make sure the port is numeric
  port="$1"
  if ! [[ "${port}" =~ ^[0-9]+$ ]]; then
    usage
    exit 1
  fi

  # lsof exits 1 when nothing uses the port
  listing="$(sudo lsof -i ":${port}" || true)"
  pid="$(awk '$0~ / \(LISTEN\)$/ { print $2; exit; }' <<< "${listing}")"

  if [[ -z "${pid}" ]]; then
    echo "No program found for port ${port}"
    exit 1
  fi

  printf '%s\t' "${pid}"

  sed -e 's|\x0| |g' < "/proc/${pid}/cmdline"
  echo
}

main "$@"
