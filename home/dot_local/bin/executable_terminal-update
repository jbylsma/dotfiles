#!/usr/bin/env bash
set -e
shopt -s inherit_errexit

#
_title() {
  local char
  local title

  char='*'
  title="$1"

  printf "\\n%$((${#title} + 4))s\\n" | tr ' ' "${char}"
  printf "%s${char} ${title} ${char}\\n"
  printf "%$((${#title} + 4))s\\n" | tr ' ' "${char}"
}

# Print the files chezmoi deployed that the source no longer has, if they're
# still on disk. chezmoi's state keeps every target it has written.
_chezmoi_orphans() {
  local template
  local written
  local managed
  local path
  local -A is_managed=()

  template='{{ range (output "chezmoi" "state" "get-bucket"
    "--bucket" "entryState" "--format" "json" | fromJson | keys | sortAlpha)
  }}{{ . }}{{ "\n" }}{{ end }}'
  written="$(chezmoi execute-template "${template}")"
  managed="$(chezmoi managed --path-style absolute)"

  while IFS= read -r path; do
    if [[ -n "${path}" ]]; then
      is_managed["${path}"]=1
    fi
  done <<< "${managed}"

  while IFS= read -r path; do
    if [[ -n "${path}" && -z "${is_managed[${path}]+_}" ]] &&
      [[ -e "${path}" || -L "${path}" ]]; then
      printf '%s\n' "${path}"
    fi
  done <<< "${written}"
}

#
update_composer() {
  _title "Composer"

  if ! command -v composer >/dev/null; then
    echo "composer not found" >&2
    return
  fi

  composer_path="$(command -v "composer")"
  if [[ "${composer_path}" == "${composer_path##"${HOME}"}" ]]; then
    echo "Non-local composer found" >&2
    return
  fi

  composer self-update

  if ! composer global info >/dev/null 2>&1; then
    echo "Composer could not find global project" >&2 && \
    return
  fi

  composer global update
}

#
update_dotfiles() {
  local config
  local orphans
  local -a orphan_list

  config="${XDG_CONFIG_HOME:-${HOME}/.config}/chezmoi/chezmoi.toml"

  _title "dotfiles"

  if ! command -v chezmoi >/dev/null || [[ ! -f "${config}" ]]; then
    echo "chezmoi isn't set up. Clone the dotfiles to ~/.local/share/chezmoi," >&2
    echo "then run ~/.local/share/chezmoi/misc/bootstrap." >&2
    return
  fi

  # Pulls fast-forward only, then applies. A bumped chezmoi pin installs
  # itself through the repo's run_onchange_ installer script.
  chezmoi update

  # chezmoi leaves a file in place when it's removed from the source
  orphans="$(_chezmoi_orphans)"
  if [[ -n "${orphans}" ]]; then
    echo 'Files chezmoi deployed that the repo no longer has:' >&2
    mapfile -t orphan_list <<< "${orphans}"
    printf '  %s\n' "${orphan_list[@]}" >&2
    echo 'Review, then delete them.' >&2
  fi
}

#
update_vim() {
  _title "vim-plug"

  test ! -f "${HOME}/.vim/autoload/plug.vim" && \
    echo "vim-plug not found" >&2 && \
    return

  # vim-plug itself is pinned by chezmoi, so PlugUpgrade isn't used
  vim -Nes -u ~/.vim/vimrc -i NONE +PlugClean\! \
    +'PlugUpdate --sync' +qall </dev/null
}

#
main() {
  local type
  declare -a types

  types=(
    dotfiles
    composer
    vim
  )

  # The first argument is used for restricting updates to a single type
  if [[ $# -gt 0 ]]; then
    declare -f "update_$1" >/dev/null || {
      echo "Unknown update type: $1" >&2
      exit 1
    }

    types=("$1")
  fi


  for type in "${types[@]}"; do
    "update_${type}"
  done
  echo -e "\\n${0} completed"
}
main "$@"
