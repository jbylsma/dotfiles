#!/usr/bin/env bash
# Report on where this host's installed packages came from, using dnf
# (RHEL 8 and later).
set -euo pipefail
shopt -s inherit_errexit

usage() {
  echo "Usage: $(basename "$0") [-hp]"
}

help() {
  usage
  cat <<'EOD'

Reports on the following:
* Disabled repositories with installed packages
* Installed packages with missing repositories
* Manually installed packages

-h Prints help
-p Prints packages that have either disabled or missing repositories
EOD
}

# Each repository and its status, as "id enabled" or "id disabled"
get_repos() {
  dnf -q repolist all | awk 'NR > 1 { print $1, $NF }' | sort
}

# Each installed package and its repository, as "repo name". Packages
# installed from a local file, or with no recorded repository, get "!manual".
get_packages() {
  dnf -q repoquery --installed --qf='%{from_repo}\t%{name}' |
    awk -F'\t' '
      {
        repo = $1
        if (repo == "" || repo == "@commandline" || repo == "@System") {
          repo = "!manual"
        }
        print repo, $2
      }
    ' |
    sort
}

# For each repository in $1 with packages in $2, print the repository and its
# package count, and the packages themselves with -p
print_repo_packages() {
  local repos="$1"
  local packages="$2"
  local print_packages="$3"
  local repo repo_packages count

  while read -r repo; do
    if [[ -z "${repo}" || "${repo:0:1}" == '!' ]]; then
      continue
    fi

    repo_packages="$(awk -v repo="${repo}" '$1 == repo { print $2 }' \
      <<< "${packages}")"
    if [[ -z "${repo_packages}" ]]; then
      continue
    fi

    count="$(wc -l <<< "${repo_packages}")"
    printf '%s\t%s\n' "${repo}" "${count}"
    if [[ "${print_packages}" == 'true' ]]; then
      printf '\t%s\n' "${repo_packages//$'\n'/$'\n\t'}"
    fi
  done <<< "${repos}"
}

main() {
  local print_packages='false'
  local opt packages repos disabled_repos missing_repos manual_packages

  while getopts ':hp' opt; do
    case "${opt}" in
      h)
        help
        exit
        ;;
      p)
        print_packages='true'
        ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
  done

  if ! command -v dnf >/dev/null; then
    echo 'dnf not found; this needs RHEL 8 or later' >&2
    exit 1
  fi

  packages="$(get_packages)"
  repos="$(get_repos)"

  disabled_repos="$(awk '$2 == "disabled" { print $1 }' <<< "${repos}")"
  # Repositories that packages came from, but that dnf no longer knows about
  missing_repos="$(awk '
    NR == FNR { known[$1]; next }
    !($1 in known) && !seen[$1]++ { print $1 }
  ' <(printf '%s\n' "${repos}") <(printf '%s\n' "${packages}"))"
  manual_packages="$(awk '$1 == "!manual" { print $2 }' <<< "${packages}")"

  echo 'Disabled repositories with installed packages'
  echo '---------------------------------------------'
  print_repo_packages "${disabled_repos}" "${packages}" "${print_packages}"
  echo

  echo 'Installed packages with missing repositories'
  echo '--------------------------------------------'
  print_repo_packages "${missing_repos}" "${packages}" "${print_packages}"
  echo

  echo 'Manually installed packages'
  echo '---------------------------'
  if [[ -n "${manual_packages}" ]]; then
    echo "${manual_packages}"
  fi
  echo
}
main "$@"
