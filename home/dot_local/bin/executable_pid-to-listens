#!/usr/bin/env bash
# Show all listening ports for a PID
set -e

usage() {
    echo "Usage: $(basename "$0") [pid]"
}

main() {
  local pid

  if [[ $# -ne 1 ]]; then
    usage
    exit 1
  fi

  pid="$1"

  if [[ ! "${pid}" =~ ^[1-9][0-9]*$ ]]; then
    usage
    exit 1
  fi

  sudo lsof -a -nP -p "${pid}" -i TCP -sTCP:LISTEN
}
main "$@"
