#!/usr/bin/env bash
# Changes a file's ownership to the current user, with awareness of sudo
set -e

usage() {
  echo "Usage: $(basename "$0") [-gh] files"
}

main() {
  local set_group
  local gid
  local uid
  local owner

  while getopts ":gh" opt; do
    case "${opt}" in
      g)
        set_group=1
        ;;
      h)
        usage
        exit
        ;;
      *)
        echo "Invalid option: -${OPTARG}" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
  shift "$((OPTIND - 1))"

  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  if [[ -n "${SUDO_UID}" ]]; then
    uid="${SUDO_UID}"
  else
    uid="${UID}"
  fi

  owner="${uid}"
  if [[ "${set_group}" == 1 ]]; then
    gid="$(id -gn "${uid}")"
    owner+=":${gid}"
  fi

  chown "${owner}" "${@}"
}
main "$@"
