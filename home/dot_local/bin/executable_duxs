#!/usr/bin/env bash
# Run du against all children of a directory, excluding outside mounts
# Linux-specific because BSD du doesn't support excluding files
# Use caution:
# * Mostly likely will fail on resources with newlines in them.
# * Mount points with spaces aren't excluded, because mountinfo escapes them.
set -euo pipefail
shopt -s inherit_errexit

readonly MOUNT_FILE="/proc/self/mountinfo"

usage() {
  echo "Usage: $(basename "$0") [du arguments] {dir}"
}

###
# In a directory, get all immediate resources on the same filesystem
# Arguments:
#   Directory to get resources for, as a full path
###
get_dir_resources() {
  local dir
  local children
  dir="$1"

  children="$(find "${dir}" -mindepth 1 -maxdepth 1 | sort)"
  if [[ -z "${children}" ]]; then
    return
  fi

  # Print the children that aren't mount points, other than /
  awk '
    NR == FNR { if ($5 != "/") mounts[$5]; next }
    !($0 in mounts)
  ' "${MOUNT_FILE}" - <<< "${children}"
}

main() {
  local dir
  local listing
  local -a resources

  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  if [[ ! -r "${MOUNT_FILE}" ]]; then
    echo "Cannot read ${MOUNT_FILE}" >&2
    exit 1
  fi

  dir="${!#}"
  set -- "${@:1:$#-1}"
  if [[ ! -d "${dir}" ]]; then
    echo "Invalid directory: ${dir}" >&2
    exit 1
  fi
  # Resolve symlinks, . and .., so the paths match mountinfo's
  dir="$(cd -P "${dir}" && pwd)"

  listing="$(get_dir_resources "${dir}")"
  if [[ -z "${listing}" ]]; then
    exit
  fi
  mapfile -t resources <<< "${listing}"
  du "$@" -sx "${resources[@]}"
}
main "$@"
