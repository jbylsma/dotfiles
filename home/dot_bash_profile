# Login bash: SSH sessions, TTYs, and tmux panes. Environment comes from
# ~/.profile, and interactive setup from ~/.bashrc.

if [[ -f "${HOME}/.profile" ]]; then
  # shellcheck source=/dev/null
  . "${HOME}/.profile"
fi

if [[ -f "${HOME}/.bashrc" ]]; then
  # shellcheck source=/dev/null
  . "${HOME}/.bashrc"
fi
