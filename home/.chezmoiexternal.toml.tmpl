{{/*
  Third-party downloads. Each URL names a fixed tag or commit, and chezmoi
  refuses a download that doesn't match its SHA-256.

  To bump one: change the tag or commit in its URL, run `chezmoi apply`, and
  check the hash in the "SHA256 mismatch" error against your own download of
  the same URL before pasting it in.
*/ -}}
[".vim/autoload/plug.vim"]
    type = "file"
    url = "https://raw.githubusercontent.com/junegunn/vim-plug/0.15.0/plug.vim"
    checksum.sha256 = "f2e856512c982063d0f4353744a29208e98fc622a474209e3a022969c974654a"

