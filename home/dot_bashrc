# shellcheck shell=bash
# Environment for shells that skipped ~/.profile, such as `ssh host cmd`,
# which bash on Debian and RHEL sources this file for
if [[ -z "${DOTFILES_PROFILE_LOADED:-}" && -f "${HOME}/.profile" ]]; then
  # shellcheck source=/dev/null
  . "${HOME}/.profile"
fi

# The rest is for interactive shells only
[[ $- == *i* ]] || return

# Private function for quietly checking for command
function _which {
  command -v "$@" >/dev/null 2>&1
  return $?
}

# History configuration
export HISTSIZE=
export HISTFILESIZE=
shopt -s histappend

# Prompt colors: the path is red with background jobs, otherwise green. The
# host is red over SSH, otherwise bold cyan. PS1 calls these at each prompt,
# so the host color follows SSH_CONNECTION after tue.
_prompt_path_color() {
  local pids
  pids="$(jobs -p)"
  if [[ -n "${pids}" ]]; then printf '31'; else printf '32'; fi
}
_prompt_host_color() {
  if [[ -n "${SSH_CONNECTION+x}" ]]; then printf '31'; else printf '1;36'; fi
}

# Terminal configuration
if [[ -n "${PS1}" ]]; then
  # shellcheck disable=SC2016 # PS1 expands these at each prompt
  PS1='\[\e[$(_prompt_path_color)m\][\w]\[\e[0m\]\n\[\e[$(_prompt_host_color)m\]\u@\h\[\e[1;33m\]$ \[\e[0m\]'
fi

# enable bash completion
if ! shopt -oq posix; then
  if [[ -f /usr/share/bash-completion/bash_completion ]]; then
    # shellcheck source=/dev/null
    . /usr/share/bash-completion/bash_completion
  elif [[ -f /etc/bash_completion ]]; then
    # shellcheck source=/dev/null
    . /etc/bash_completion
  fi
fi

# Disable XON/XOFF flow control, which allows Ctrl-S for searching
if _which stty && [[ -t 0 && $- = *i* ]]; then
  stty -ixon
fi

# Aliases
alias ack='ack --pager="less -SFRX"'
alias ag='ag --pager="less -SFRX"'
alias ffprobe='ffprobe -hide_banner'
alias grep='grep -I --color=auto'
alias less='less -SR'
alias lsof='lsof -anP'
alias psw='ps -wwf'
alias vij='vim -c "set ft=json"'

# If ls supports the --color argument, alias ls to use it.
if ls --color /dev/null >/dev/null 2>&1; then
  alias ls='ls --color'
fi

# Override SSH timeout. This does nothing where TMOUT is read-only, as on
# hardened RHEL hosts.
unset TMOUT 2>/dev/null

# Function to lazily copy completion from one command to another
_lazy_copy_completion() {
    local source_cmd="$1"
    local target_cmd="$2"
    local wrapper_func="_lazy_copy_completion_${target_cmd}"

    local definition
    IFS= read -r -d '' definition <<EOF
${wrapper_func}() {
    if ! complete -p "${source_cmd}" &>/dev/null; then
        _completion_loader "${source_cmd}"
    fi

    local comp_spec=\$(complete -p "${source_cmd}")
    comp_spec=\${comp_spec% ${source_cmd}}
    eval "\${comp_spec} ${target_cmd}"

    # Extract and invoke the completion function
    local comp_func=\$(echo "\${comp_spec}" | sed -n 's/.*-F \([^ ]*\).*/\1/p')
    if [[ -n "\${comp_func}" ]]; then
        "\${comp_func}" "\$@"
    fi
}
EOF
    eval "${definition}"

    complete -F "${wrapper_func}" "${target_cmd}"
}

# Create Docker shortcuts
declare -A D_SHORTCUTS=(
  [c]='compose'
  [cb]='compose build'
  [cd]='compose down --remove-orphans'
  [ce]='compose exec'
  [cl]='compose logs'
  [cr]='compose restart'
  [cu]='compose up -d'
)

function d {
  if [[ $# -gt 0 ]]; then
    local shortcut="$1"
    if [[ -n "${D_SHORTCUTS[${shortcut}]}" ]]; then
      shift
      # shellcheck disable=SC2086
      docker ${D_SHORTCUTS[${shortcut}]} "$@"
    else
      docker "$@"
    fi
  else
    docker "$@"
  fi
}

# Quickly change to the Git top level dir
function gcd {
  local path

  if ! command -v git >/dev/null 2>&1; then
    echo "Git not found" >&2
    return 1
  fi

  if path="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if ! cd "${path}"; then
      echo "Could not change to directory ${path}." >&2
      return 1
    fi
  else
    echo "Could not determine Git toplevel" >&2
    return 1
  fi
}

# Shorthand for tagged SSH profiles defined in ~/.ssh/config
alias essh='ssh -P ephemeral'
alias pssh='ssh -P password'
_lazy_copy_completion ssh essh
_lazy_copy_completion ssh pssh

# Run ps restricted to the current user
function psu {
  ps -u "${EUID}" "$@"
}

# Abbreviate dig +short with completion capabilities
function digs {
  dig "$@" +short
}
_lazy_copy_completion dig digs

# Update terminal variables from tmux
function tue {
  local env
  env="$(tmux show-environment -s)" || return
  eval "${env}"
}

# Disable terminal focus-event reporting on this pane, reporting prior state
function unfocus {
  local reply stty_orig mode
  stty_orig=$(stty -g)
  stty -echo -icanon min 0 time 10
  # shellcheck disable=SC2016 # $p ends the DECRQM request; it isn't a variable
  printf '\e[?1004$p'
  IFS= read -r -d y -t 1 reply
  stty "${stty_orig}"
  printf '\e[?1004l'

  mode="${reply##*;}"
  mode="${mode%\$}"

  case "${mode}" in
    1|3) echo "focus-event reporting was enabled; now disabled" ;;
    2|4) echo "focus-event reporting was already disabled" ;;
    *)   echo "focus-event reporting state unknown (no response); disable sequence sent anyway" ;;
  esac
}

# Unset private _which function
unset -f _which

# Source local (non-shared) configuration.
if [[ -f "${HOME}/.bashrc.local" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.bashrc.local"
fi
